---
import SiteLayout from '../components/SiteLayout.astro';
---

<SiteLayout>
  <div class="text-center">
    <div class="mx-auto w-full">
      <h1 class="text-2xl font-normal md:text-3xl">Energy-Efficient Electronics and Design Automation (E<sup>3</sup>DA) Lab</h1>
    </div>
    <div class="mx-auto w-10/12 max-w-2xl">
      <h2 class="mt-4 text-xl font-normal">Pronounced "Triple EDA Lab"</h2>
      <h3 class="mt-3 text-xl font-normal">Directed by <a href="/people/#Faculty" class="link link-primary">Prof. Yarui Peng</a></h3>
      <img class="mx-auto my-5 h-auto max-w-full" src="/img/e3da/logo/logo.svg" alt="E3DA Lab logo" />
      <h2 class="text-xl font-normal">Electrical Engineering and Computer Science (EECS) Department</h2>
      <h3 class="mt-3 text-xl font-normal">University of Arkansas</h3>
    </div>
  </div>
</SiteLayout>
