---
import LegacyLayout from '../components/LegacyLayout.astro';
import LegacyPanel from '../components/LegacyPanel.astro';
import { rows } from '../data/legacy';
import { researchOverview } from '../data/lab-profile';

const projects = [
  ...rows('research/Power-CAD/project/Ongoing.csv'),
  ...rows('research/VLSI-CAD/project/Ongoing.csv'),
  ...rows('research/Power-CAD/project/Completed.csv'),
];
---

<LegacyLayout title="Research | E3DA Lab">
  <LegacyPanel title="Energy-Efficient Electronics & Design Automation" headingLevel={1} id="Overview"><div class="content-copy"><p>{researchOverview.introduction}</p><h3>Research Areas</h3><div class="join rounded-box research-area-links join-vertical sm:join-horizontal" role="group" aria-label="Research areas">{researchOverview.areas.map((area) => <a class="btn btn-outline join-item font-semibold text-primary" href={`/research/${area.id.toLowerCase()}/`}>{area.title}</a>)}</div><p>{researchOverview.current}</p></div></LegacyPanel>
  <LegacyPanel title="Projects" id="Projects"><div class="table-scroll" role="region" aria-label="Projects table" tabindex="0"><table class="table table-zebra legacy-data-table"><thead><tr><th>Project</th><th>Sponsor</th><th>Period</th><th>PI</th></tr></thead><tbody>{projects.map((row) => <tr class="transition-colors duration-150 hover:bg-primary/10 motion-reduce:transition-none"><td>{row[0]}</td><td>{row[1]}</td><td>{row[4]} - {row[5]}</td><td>{row.slice(6).join(', ')}</td></tr>)}</tbody></table></div></LegacyPanel>
</LegacyLayout>