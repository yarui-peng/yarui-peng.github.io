---
import LegacyLayout from '../components/LegacyLayout.astro';
import LegacyPanel from '../components/LegacyPanel.astro';
import { rows } from '../data/legacy';
import { researchOverview } from '../data/lab-profile';

const projects = [
  ...rows('research/Power-CAD/project/Ongoing.csv').map((row) => ({ status: 'Ongoing', row })),
  ...rows('research/VLSI-CAD/project/Ongoing.csv').map((row) => ({ status: 'Ongoing', row })),
  ...rows('research/Power-CAD/project/Completed.csv').map((row) => ({ status: 'Completed', row })),
];
---

<LegacyLayout title="Research | E3DA Lab">
  <LegacyPanel title="Energy-Efficient Electronics & Design Automation" headingLevel={1} id="Overview"><div class="content-copy"><p>{researchOverview.introduction}</p><h3>Research Areas</h3><ul>{researchOverview.areas.map((area) => <li>{area.title}</li>)}</ul><p>{researchOverview.current}</p></div></LegacyPanel>
  <div class="grid gap-3 md:grid-cols-2">
    {researchOverview.areas.map((area) => <LegacyPanel title={area.title} id={area.id} class="research-area-panel"><div class="content-copy"><p>{area.description}</p>{area.images.length > 0 && <div class="research-gallery-shell"><button class="research-gallery-control" type="button" data-gallery-prev aria-label={`Previous ${area.title} image`} title="Previous image">&#8592;</button><div class="research-gallery carousel carousel-center" aria-label={`${area.title} gallery`}>{area.images.map((image) => <a class="research-gallery-item carousel-item" href={image.src} aria-label={`Open ${image.alt}`} title={image.alt}><img src={image.src} alt={image.alt} loading="lazy" /></a>)}</div><button class="research-gallery-control" type="button" data-gallery-next aria-label={`Next ${area.title} image`} title="Next image">&#8594;</button></div>}</div></LegacyPanel>)}
  </div>
  <LegacyPanel title="Projects" id="Projects"><div class="table-scroll" role="region" aria-label="Projects table" tabindex="0"><table class="table table-zebra legacy-data-table"><thead><tr><th>Status</th><th>Project</th><th>Sponsor</th><th>Period</th><th>PI</th></tr></thead><tbody>{projects.map(({ status, row }) => <tr class="transition-colors duration-150 hover:bg-primary/10 motion-reduce:transition-none"><td>{status}</td><td>{row[0]}</td><td>{row[1]}</td><td>{row[4]} - {row[5]}</td><td>{row.slice(6).join(', ')}</td></tr>)}</tbody></table></div></LegacyPanel>
</LegacyLayout>

<script>
  document.querySelectorAll<HTMLElement>('.research-gallery-shell').forEach((shell) => {
    const gallery = shell.querySelector<HTMLElement>('.research-gallery');
    const item = shell.querySelector<HTMLElement>('.research-gallery-item');
    const step = () => (item?.getBoundingClientRect().width ?? 0) + 12;
    shell.querySelector<HTMLButtonElement>('[data-gallery-prev]')?.addEventListener('click', () => gallery?.scrollBy({ left: -step(), behavior: 'smooth' }));
    shell.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => gallery?.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>