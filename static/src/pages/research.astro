---
import LegacyLayout from '../components/LegacyLayout.astro';
import LegacyPanel from '../components/LegacyPanel.astro';
import { rows } from '../data/legacy';
import { researchOverview } from '../data/lab-profile';

const projects = [
  ...rows('research/Power-CAD/project/Ongoing.csv').map((row) => ({ area: 'EDA4Power', status: 'Ongoing', row })),
  ...rows('research/VLSI-CAD/project/Ongoing.csv').map((row) => ({ area: 'EDA4Chiplet', status: 'Ongoing', row })),
  ...rows('research/Power-CAD/project/Completed.csv').map((row) => ({ area: 'EDA4Power', status: 'Completed', row })),
];
---

<LegacyLayout title="Research | E3DA Lab">
  <LegacyPanel title="Energy-Efficient Electronics & Design Automation" headingLevel={1} id="Overview"><div class="content-copy"><p>{researchOverview.introduction}</p><h3>Research Areas</h3><ul>{researchOverview.areas.map((area) => <li>{area}</li>)}</ul><p>{researchOverview.current}</p></div></LegacyPanel>
  <div class="grid gap-3 md:grid-cols-2">
    {researchOverview.areas.map((area) => <LegacyPanel title={area.title} id={area.id} class="research-area-panel"><div class="content-copy"><p>{area.description}</p>{area.images.length > 0 && <div class="research-gallery">{area.images.map((image) => <figure><img src={image.src} alt={image.alt} loading="lazy" /><figcaption>{image.alt}</figcaption></figure>)}</div>}</div></LegacyPanel>)}
  </div>
  <LegacyPanel title="Projects" id="Projects"><div class="table-scroll" role="region" aria-label="Projects table" tabindex="0"><table class="table table-zebra legacy-data-table"><thead><tr><th>Area</th><th>Status</th><th>Project</th><th>Sponsor</th><th>Period</th><th>PI</th></tr></thead><tbody>{projects.map(({ area, status, row }) => <tr><td>{area}</td><td>{status}</td><td>{row[0]}</td><td>{row[1]}</td><td>{row[4]} - {row[5]}</td><td>{row.slice(6).join(', ')}</td></tr>)}</tbody></table></div></LegacyPanel>
</LegacyLayout>