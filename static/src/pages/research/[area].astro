---
import SiteLayout from '../../components/SiteLayout.astro';
import Card from '../../components/Card.astro';
import ResearchGallery from '../../components/ResearchGallery.astro';
import { researchOverview } from '../../data/lab-profile';

export function getStaticPaths() {
  return researchOverview.areas.map((area) => ({
    params: { area: area.id.toLowerCase() },
    props: { area },
  }));
}

const { area } = Astro.props;
---

<SiteLayout title={`${area.title} | E3DA Lab`}>
  <Card title={area.title} headingLevel={1} id={area.id}>
    <div class="content-copy">
      <p>{area.description}</p>
      <ResearchGallery areaTitle={area.title} images={area.images} />
    </div>
  </Card>
</SiteLayout>