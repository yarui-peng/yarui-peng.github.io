---
import LegacyLayout from '../../components/LegacyLayout.astro';
import LegacyPanel from '../../components/LegacyPanel.astro';
import ResearchGallery from '../../components/ResearchGallery.astro';
import { researchOverview } from '../../data/lab-profile';

export function getStaticPaths() {
  return researchOverview.areas.map((area) => ({
    params: { area: area.id.toLowerCase() },
    props: { area },
  }));
}

const { area } = Astro.props;
---

<LegacyLayout title={`${area.title} | E3DA Lab`}>
  <LegacyPanel title={area.title} headingLevel={1} id={area.id}>
    <div class="content-copy">
      <p>{area.description}</p>
      <ResearchGallery areaTitle={area.title} images={area.images} />
      <div class="research-page-links join join-vertical sm:join-horizontal" role="group" aria-label="Research navigation">
        <a class="btn btn-primary join-item" href="/research/">Research overview</a>
        {researchOverview.areas.filter((otherArea) => otherArea.id !== area.id).map((otherArea) => <a class="btn btn-outline join-item" href={`/research/${otherArea.id.toLowerCase()}/`}>{otherArea.title}</a>)}
      </div>
    </div>
  </LegacyPanel>
</LegacyLayout>