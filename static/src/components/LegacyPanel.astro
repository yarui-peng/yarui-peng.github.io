---
interface Props {
  title: string;
  id?: string;
  headingLevel?: 1 | 2;
  tone?: 'success' | 'primary';
  class?: string;
}

const { title, id, headingLevel = 2, tone = 'success', class: className = '' } = Astro.props;
---

<section id={id} class:list={['legacy-card', 'card', 'border', 'border-base-300', 'bg-base-100', 'shadow-sm', `legacy-card-${tone}`, 'mb-3', className]}>
  {headingLevel === 1 ? <h1 class:list={['legacy-card-header', 'card-title', 'px-5', 'py-3', 'text-center', tone === 'primary' ? 'bg-primary text-primary-content' : 'bg-secondary text-secondary-content']}>{title}</h1> : <h2 class:list={['legacy-card-header', 'card-title', 'px-5', 'py-3', 'text-center', tone === 'primary' ? 'bg-primary text-primary-content' : 'bg-secondary text-secondary-content']}>{title}</h2>}
  <div class="card-body"><slot /></div>
</section>