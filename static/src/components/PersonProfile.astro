---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  name: string;
  image?: string;
  email?: string;
  links?: LinkItem[];
  badge?: string;
  class?: string;
}

const { name, image, email, links = [], badge, class: className = '' } = Astro.props;
---

<article class:list={['person-profile', className]}>
  {image && <img class="person-profile-image" src={image} alt={name} />}
  <div class="person-profile-content">
    <div class="person-profile-heading">
      <h3>{name}</h3>
      {badge && <span class="person-profile-badge">{badge}</span>}
      {email && <a class="person-email" href={`mailto:${email}`}>{email}</a>}
      {links.length > 0 && <div class="person-actions join rounded-box" role="group" aria-label={`${name} links`}>{links.map((link) => <a class="person-action join-item btn btn-sm btn-accent font-semibold text-accent-content" href={link.href}>{link.label}</a>)}</div>}
    </div>
    <div class="content-copy"><slot /></div>
  </div>
</article>