---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  name: string;
  image?: string;
  email?: string;
  links?: LinkItem[];
}

const { name, image, email, links = [] } = Astro.props;
---

<article class="person-profile">
  {image && <img class="person-profile-image" src={image} alt={name} />}
  <div class="person-profile-content">
    <div class="person-profile-heading">
      <h3>{name}</h3>
      {email && <a class="person-email" href={`mailto:${email}`}>{email}</a>}
      {links.length > 0 && <div class="person-actions">{links.map((link) => <a class="person-action" href={link.href}>{link.label}</a>)}</div>}
    </div>
    <div class="content-copy"><slot /></div>
  </div>
</article>