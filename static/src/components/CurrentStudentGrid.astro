---
import type { CurrentStudent } from '../data/current-students';
import PersonProfile from './PersonProfile.astro';

interface Props {
  students: CurrentStudent[];
}

const { students } = Astro.props;
const degreeGroups: CurrentStudent['degree'][] = ['Ph.D.', 'MS', 'BS'];
---

{degreeGroups.map((degree) => {
  const group = students.filter((student) => student.degree === degree);
  if (group.length === 0) return null;

  return <section class="current-student-group" aria-labelledby={`current-students-${degree}`}>
    <h3 id={`current-students-${degree}`}>{degree} Students</h3>
    {group.map((student) => {
      const siteUrl = `https://${student.githubUsername}.github.io/`;
      const avatarUrl = `https://github.com/${student.githubUsername}.png?size=256`;

      return <PersonProfile
        name={student.name}
        image={avatarUrl}
        links={[
          { label: 'Email', href: `mailto:${student.email}` },
          { label: 'Personal site', href: siteUrl },
        ]}
      >
        <span class="current-student-year">{student.entryYear}</span>
      </PersonProfile>;
    })}
  </section>;
})}