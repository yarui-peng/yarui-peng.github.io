---
import type { CurrentStudent } from '../data/current-students';
import PersonProfile from './PersonProfile.astro';
import { currentStudentBios } from '../data/current-student-bios';

interface Props {
  students: CurrentStudent[];
  degree: CurrentStudent['degree'];
}

const { students, degree } = Astro.props;
const degreeStudents = students.filter((student) => student.degree === degree);
const entryYears = [...new Set(degreeStudents.map((student) => student.entryYear))].sort((first, second) => second.localeCompare(first));
---

{entryYears.map((entryYear) => {
  const group = degreeStudents.filter((student) => student.entryYear === entryYear);

  return <section class="current-student-group" aria-labelledby={`current-students-${degree}-${entryYear}`}>
    <h3 id={`current-students-${degree}-${entryYear}`}>{entryYear} Entry</h3>
    <div class="current-student-grid">
      {group.map((student) => {
        return <PersonProfile
          name={student.name}
          image={student.imagePath}
          links={[
            { label: 'Email', href: `mailto:${student.email}` },
            { label: 'Website', href: student.websiteUrl },
          ]}
        >
            <p class="current-student-bio">{currentStudentBios[student.e3daId]}</p>
        </PersonProfile>;
      })}
    </div>
  </section>;
})}