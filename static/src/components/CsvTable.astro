---
import Card from './Card.astro';

interface Props {
  title?: string;
  data: string[][];
}

const { title, data } = Astro.props;
const columnCount = Math.max(...data.map((row) => row.length), 1);
const [header, ...body] = data;
---

<Card title={title ?? 'Data'}>
  <div class="table-scroll" role="region" aria-label={`${title ?? 'Data'} table`} tabindex="0">
    <table class="table table-zebra site-data-table">
      {header && header.length > 1 && <thead><tr>{header.map((cell) => <th>{cell}</th>)}</tr></thead>}
      <tbody>{body.map((row) => row.length === 1
        ? <tr class="table-section-row"><th colspan={columnCount}>{row[0]}</th></tr>
        : <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
      )}</tbody>
    </table>
  </div>
</Card>