---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  areaTitle: string;
  images: GalleryImage[];
}

const { areaTitle, images } = Astro.props;
---

{images.length > 0 && <div class="research-gallery-shell"><button class="research-gallery-control btn btn-circle btn-sm btn-outline" type="button" data-gallery-prev aria-label={`Previous ${areaTitle} image`} title="Previous image">&#8592;</button><div class="research-gallery carousel carousel-center" aria-label={`${areaTitle} gallery`}>{images.map((image) => <a class="research-gallery-item carousel-item w-full" href={image.src} aria-label={`Open ${image.alt}`} title={image.alt}><img src={image.src} alt={image.alt} loading="lazy" /></a>)}</div><button class="research-gallery-control btn btn-circle btn-sm btn-outline" type="button" data-gallery-next aria-label={`Next ${areaTitle} image`} title="Next image">&#8594;</button></div>}

<script>
  document.querySelectorAll<HTMLElement>('.research-gallery-shell').forEach((shell) => {
    const gallery = shell.querySelector<HTMLElement>('.research-gallery');
    const item = shell.querySelector<HTMLElement>('.research-gallery-item');
    const step = () => (item?.getBoundingClientRect().width ?? 0) + 12;
    shell.querySelector<HTMLButtonElement>('[data-gallery-prev]')?.addEventListener('click', () => gallery?.scrollBy({ left: -step(), behavior: 'smooth' }));
    shell.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => gallery?.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>