---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  areaTitle: string;
  images: GalleryImage[];
}

const { areaTitle, images } = Astro.props;
---

{images.length > 0 && <figure class="hover-gallery w-full" aria-label={`${areaTitle} gallery`}>{images.map((image) => <img src={image.src} alt={image.alt} loading="lazy" />)}</figure>}
