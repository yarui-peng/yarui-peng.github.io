---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  areaTitle: string;
  images: GalleryImage[];
}

const { areaTitle, images } = Astro.props;
---

{images.length > 0 && <div class="research-hover-gallery" aria-label={`${areaTitle} gallery`}>{images.map((image) => <a class="research-hover-gallery-item" href={image.src} aria-label={`Open ${image.alt}`} title={image.alt}><img src={image.src} alt={image.alt} loading="lazy" /></a>)}</div>}
