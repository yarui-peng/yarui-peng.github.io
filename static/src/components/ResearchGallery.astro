---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  areaTitle: string;
  images: GalleryImage[];
}

const { areaTitle, images } = Astro.props;
const galleryId = areaTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

{images.length > 0 && <div id={`${galleryId}-gallery`} class="research-gallery carousel w-full" aria-label={`${areaTitle} gallery`}>{images.map((image, index) => { const previous = index === 0 ? images.length - 1 : index - 1; const next = index === images.length - 1 ? 0 : index + 1; return <div id={`${galleryId}-slide-${index + 1}`} class="research-gallery-item carousel-item relative w-full"><img class="w-full" src={image.src} alt={image.alt} loading="lazy" /><div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between"><a class="btn btn-circle" href={`#${galleryId}-slide-${previous + 1}`} aria-label={`Previous ${areaTitle} image`} title="Previous image">&#10094;</a><a class="btn btn-circle" href={`#${galleryId}-slide-${next + 1}`} aria-label={`Next ${areaTitle} image`} title="Next image">&#10095;</a></div></div>; })}</div>}
