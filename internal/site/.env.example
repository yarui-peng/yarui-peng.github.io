# Keep protected documents outside the repository and outside static/public.
E3DA_PRIVATE_ROOT=/srv/e3da/private/e3da
UARK_PRIVATE_ROOT=/srv/e3da/private/uark
E3DA_PUBLIC_ROOT=/srv/e3da/public
# Required in production for survey-gated release downloads.
SURVEY_SECRET=replace-with-a-long-random-secret
# Keep this outside the repository; each line is one JSON survey response.
SURVEY_LOG_PATH=/var/log/e3da/download-surveys.jsonl
