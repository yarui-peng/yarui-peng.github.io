---
import DynamicLayout from '../layouts/DynamicLayout.astro';
import { ReadManuals } from '../lib/manuals';

const Releases = (await ReadManuals()).filter((Manual) => Manual.group === 'public');
const Session = Astro.locals.Session;
function DownloadUrl(Release: typeof Releases[number]) {
  const Params = `group=${encodeURIComponent(Release.group)}&file=${encodeURIComponent(Release.file)}`;
  if (Release.survey === 'true' && !Session) return `/survey?${Params}`;
  return `/download?${Params}${Release.survey === 'true' ? '&survey=required' : ''}`;
}
---

<DynamicLayout title="Software releases">
  <div class="space-y-4">
    <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-sm font-semibold uppercase tracking-wide text-primary">Downloads</p><h1 class="text-3xl font-bold">Software releases</h1></div><a class="btn btn-ghost btn-sm" href="/app">Member login</a></div>
    {Releases.length ? <div class="grid gap-4 md:grid-cols-2">{Releases.map((Release) => <article class="site-card site-card-primary card border border-primary bg-base-100"><h2 class="site-card-header card-title px-4 py-2 text-center">{Release.title}</h2><div class="card-body"><p class="text-sm font-semibold text-primary">{Release.category}</p><p class="text-base-content/70">{Release.description}</p><div class="card-actions mt-2"><a class="btn btn-primary" href={DownloadUrl(Release)}>{Release.survey === 'true' && !Session ? 'Complete survey' : 'Download'}</a></div></div></article>)}</div> : <div class="alert border border-primary/30 bg-base-100"><span>No software releases have been cataloged yet.</span></div>}
  </div>
</DynamicLayout>
