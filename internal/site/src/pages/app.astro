---
import DynamicLayout from '../layouts/DynamicLayout.astro';
import { ReadTeachingRecords } from '../lib/teaching';

if (!Astro.locals.Session) return Astro.redirect('/login');
const Records = await ReadTeachingRecords();
const Headings = Records.length ? Object.keys(Records[0]) : [];
---

<DynamicLayout title="Dashboard">
  <div class="space-y-4">
    <section class="site-card site-card-primary card border border-primary bg-base-100">
      <h1 class="site-card-header card-title px-4 py-2 text-center">Member dashboard</h1>
      <div class="card-body">
        <p>Welcome, <strong>{Astro.locals.Session.Username}</strong>.</p>
        <p class="text-base-content/70">This is an independent Astro website served by the dynamic deployment.</p>
      </div>
    </section>

    <section class="site-card site-card-success card border border-secondary bg-base-100">
      <h2 class="site-card-header card-title px-4 py-2 text-center">Teaching records</h2>
      <div class="card-body">
        {Records.length ? <div class="table-scroll" role="region" aria-label="Teaching records table" tabindex="0"><table class="table table-zebra site-data-table"><thead><tr>{Headings.map((Heading) => <th>{Heading}</th>)}</tr></thead><tbody>{Records.map((Record) => <tr><>{Headings.map((Heading) => <td>{Record[Heading]}</td>)}</></tr>)}</tbody></table></div> : <p class="text-base-content/70">No teaching records yet.</p>}
      </div>
    </section>

    <section class="site-card site-card-primary card border border-primary bg-base-100">
      <h2 class="site-card-header card-title px-4 py-2 text-center">Software manuals</h2>
      <div class="card-body sm:flex-row sm:items-center sm:justify-between">
        <div><p class="text-base-content/70">Authenticated access to cataloged manuals and private files.</p></div>
        <a class="btn btn-primary" href="/manuals">Browse manuals</a>
      </div>
    </section>

    {Astro.locals.Session.IsAdmin && <section class="site-card site-card-success card border border-secondary bg-base-100"><h2 class="site-card-header card-title px-4 py-2 text-center">Administration</h2><div class="card-body"><p class="text-base-content/70">The development identity <code>yrpeng</code> currently receives the admin role. Add real authentication and explicit role storage before deployment.</p></div></section>}
  </div>
</DynamicLayout>
