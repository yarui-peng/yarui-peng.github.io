---
import '../styles/global.css';

const { title = 'Dynamic Site' } = Astro.props;
const Session = Astro.locals.Session;
const UserMenu = Session
  ? `<span class="text-sm opacity-90">${Session.Username}${Session.IsAdmin ? ' · admin' : ''}</span><a class="link link-hover" href="/logout">Log out</a>`
  : '<a class="link link-hover" href="/login">Log in</a>';
---

<!doctype html>
<html lang="en" data-theme="e3da-light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="E3DA Lab member services" />
    <title>{title} · E3DA Lab</title>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <header class="navbar bg-accent text-accent-content shadow-sm">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-4">
        <a class="text-lg font-semibold" href="/app">E3DA Lab · Dynamic</a>
        <nav class="flex items-center gap-4">{UserMenu}</nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl px-4 py-6 sm:py-10"><slot /></main>
  </body>
</html>
